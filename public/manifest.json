{
  "manifest_version": 3,
  "name": "PageLingo",
  "version": "0.1.30",
  "description": "Fast local immersive translation with layout-preserving bilingual rendering.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "contextMenus",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/pagelingo.svg",
    "96": "icons/pagelingo.svg"
  },
  "action": {
    "default_title": "PageLingo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pagelingo.svg",
      "32": "icons/pagelingo.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "builtin-glossary.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pagelingo@kerberos255",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
